{{- /* dashboard.html.tmpl — main dashboard rendered at local.vibe.
       All user-supplied fields (route names, external URLs, icons, etc.)
       are auto-escaped by html/template's contextual escaper. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
{{.Head}}
<style>{{.CSS}}</style>
<script>{{.JS}}</script>
</head>
<body>
<nav class="navbar">
  <div class="navbar-left">
    <a href="{{.Scheme}}://local.{{.TLD}}/" class="brand">local<span>.vibe</span></a>
    <div class="status-pill"><span class="led led-green"></span>Running &middot; {{.Uptime}}</div>
  </div>
  <button class="btn-add" onclick="openAddModal()">Add Route</button>
</nav>
<main class="main">
{{if .RedirectDown}}<div class="warn"><span class="led led-red"></span>HTTPS redirect is down — <code style="color:var(--text)">https://*.{{.TLD}}</code> won't connect. A VPN or firewall likely flushed it. Run <code style="color:var(--text)">vibe doctor --fix</code> to restore it.</div>{{end}}
{{if .UnknownVisible}}<div class="warn"><span class="led led-yellow"></span>No route for <strong style="color:var(--text);margin:0 4px">{{.UnknownName}}.{{.TLD}}</strong> — register it below.</div>{{end}}
<div class="toolbar">
  <div class="toolbar-left">
    <span class="toolbar-title">Routes</span>
    <span class="toolbar-count">{{.RouteCount}} active</span>
  </div>
  <div class="toolbar-right">
    <div class="search-box">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5"/><line x1="10.8" y1="10.8" x2="14.5" y2="14.5"/></svg>
      <input id="search-input" type="text" placeholder="Find routes…" autocomplete="off" spellcheck="false" oninput="filterRoutes(this.value)" onkeydown="if(event.key==='Escape'){this.value='';filterRoutes('');this.blur();event.stopPropagation()}">
      <kbd>/</kbd>
    </div>
    <div class="view-toggle">
      <button id="btn-list" class="{{.ListBtnClass}}" onclick="setView('list',true)" title="List view">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="1" y1="3" x2="15" y2="3"/><line x1="1" y1="8" x2="15" y2="8"/><line x1="1" y1="13" x2="15" y2="13"/></svg>
      </button>
      <button id="btn-grid" class="{{.GridBtnClass}}" onclick="setView('grid',true)" title="Grid view">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="5.5" height="5.5" rx="1"/><rect x="9.5" y="1" width="5.5" height="5.5" rx="1"/><rect x="1" y="9.5" width="5.5" height="5.5" rx="1"/><rect x="9.5" y="9.5" width="5.5" height="5.5" rx="1"/></svg>
      </button>
    </div>
  </div>
</div>
{{- /* route-colgroup is the single source of column widths, shared by the
       main routes table and every peer table so their columns cannot drift
       apart. Widths live on the col-* classes in theme.css. */ -}}
{{define "route-colgroup"}}<colgroup><col class="col-name"><col class="col-type"><col class="col-port"><col class="col-age"><col class="col-actions"></colgroup>{{end}}
<div class="list-view" id="list-view" style="display:{{.ListDisplay}}">
<table class="route-table">
{{template "route-colgroup"}}
<thead><tr>
  <th class="sortable" onclick="sortTable('name')">Name<span class="sort-arrow" id="arrow-name"></span></th>
  <th>Type</th>
  <th class="sortable" onclick="sortTable('port')">Port<span class="sort-arrow" id="arrow-port"></span></th>
  <th class="hide-mobile sortable" onclick="sortTable('age')">Age<span class="sort-arrow" id="arrow-age"></span></th>
  <th style="text-align:right">Actions</th>
</tr></thead>
<tbody>
<tr id="row-local">
  <td><a class="route-name-cell" href="{{.Scheme}}://local.{{.TLD}}/"><span class="led led-green row-led"></span><span class="route-icon">&#127968;</span><div><span class="route-name-link">local</span><span class="route-url">local.{{.TLD}}</span></div></a></td>
  <td class="td-type">daemon</td>
  <td class="td-port"><a href="http://localhost:{{.Port}}" target="_blank">{{.Port}}</a></td>
  <td class="td-age hide-mobile">{{.Uptime}}</td>
  <td></td>
</tr>
{{range .Routes}}
{{if .GroupHeader}}<tr class="wt-group-header"><td colspan="5">{{.GroupHeader}}</td></tr>{{end}}
<tr{{if .IsWorktree}} class="wt-tr"{{end}} data-name="{{.Name}}" data-port="{{.Port}}" data-age="{{.AgeSec}}">
  <td><a class="route-name-cell" href="{{.VibeURL}}" target="_blank"><span class="led row-led {{if ne .Type "managed"}}led-none{{else if .IsStopped}}led-gray{{else}}led-green{{end}}"></span><span class="{{if .IsStopped}}route-icon route-icon-stopped{{else}}route-icon{{end}}">{{iconHTML .Icon}}</span><div><span class="route-name-link">{{.Name}}</span><span class="route-url">{{.URLDisplay}}</span></div></a></td>
  <td class="td-type">{{.Type}}</td>
  <td class="td-port{{if .IsStopped}} td-stopped{{end}}">{{if or (eq .Type "bookmark") .Discovered}}—{{else}}<a href="http://localhost:{{.Port}}" target="_blank">{{.Port}}</a>{{end}}</td>
  <td class="td-age hide-mobile">{{.Age}}</td>
  <td><div class="td-actions">
    <span class="act-main">
    {{- if .Discovered}}<button class="btn btn-primary" onclick="startDiscoveredWorktree(this,{{.Parent}},{{.Path}})">Start</button>
    {{- else if and (eq .Type "managed") .IsRunning}}<button class="btn btn-stop" onclick="routeAction(this,'{{.Name}}','stop')">Stop</button>
    {{- else if eq .Type "managed"}}<button class="btn btn-primary" onclick="routeAction(this,'{{.Name}}','start')">Start</button>{{end -}}
    </span>
    <span class="act-edit">
    {{- if and (not .Discovered) (eq .Type "managed")}}<button class="btn-icon" onclick="openManagedModal('{{.Name}}',{{.Idle}},'{{.UserIcon}}','{{.FallbackIcon}}')" title="Settings">{{editSVG}}</button>
    {{- else if eq .Type "sticky"}}<button class="btn-icon" onclick="openEditModal('{{.Name}}',{{.Port}},'{{.ExternalURL}}','local','{{.UserIcon}}','{{.FallbackIcon}}',{{.Proxy}},{{.Insecure}})" title="Edit">{{editSVG}}</button>
    {{- else if eq .Type "bookmark"}}<button class="btn-icon" onclick="openEditModal('{{.Name}}',{{.Port}},'{{.ExternalURL}}','bookmark','{{.UserIcon}}','{{.FallbackIcon}}',{{.Proxy}},{{.Insecure}})" title="Edit">{{editSVG}}</button>{{end -}}
    </span>
  </div></td>
</tr>
{{end}}
</tbody></table>
{{if eq (len .Routes) 0}}<div class="empty">No routes registered yet.</div>{{end}}
</div>

<div class="grid-view" id="grid-view" style="display:{{.GridDisplay}}"><div class="grid-container">
<a href="{{.Scheme}}://local.{{.TLD}}/" class="grid-tile">
  <div class="tile-icon"><span>&#127968;</span></div>
  <div class="tile-name">local</div>
  <div class="tile-url">local.{{.TLD}}</div>
</a>
{{range .Routes}}
<a href="{{.VibeURL}}" target="_blank" class="{{if .IsStopped}}grid-tile tile-stopped{{else}}grid-tile{{end}}">
  <div class="tile-icon">{{iconHTML .Icon}}</div>
  <div class="tile-name">{{.Name}}</div>
  <div class="tile-url">{{.URLDisplay}}</div>
</a>
{{end}}
</div></div>

<div class="empty" id="search-empty" style="display:none">No routes match &ldquo;<span id="search-empty-q"></span>&rdquo;</div>

{{define "peers-head"}}
  <h2>Peers<span class="tag">experimental</span>{{if .PeerAdmin}}{{if .PeersEnabled}}<span class="peer-actions"><button type="button" class="btn btn-sm" onclick="openPeerModal()">Add peer</button><button type="button" class="btn btn-sm" onclick="openShowCode()">Show a code</button><button type="button" class="btn btn-sm btn-danger" onclick="turnOffPeers()">Turn off</button></span>{{else}}<span class="peer-actions"><button type="button" class="btn btn-sm" onclick="openEnablePeers()">Enable peers</button></span>{{end}}{{end}}</h2>
  <div class="peer-confirm peer-off-confirm" style="display:none">Turn off peers? Nothing will listen on the network; your pairings are kept. <button type="button" class="btn btn-sm btn-danger" onclick="setPeersEnabled(false)">Turn off</button> <button type="button" class="btn btn-sm" onclick="showPeerOffConfirm(false)">Cancel</button></div>
  {{if not .PeersEnabled}}<p class="peer-empty">Browse other machines' .{{.TLD}} routes from here.</p>{{else if not .PeerGroups}}<p class="peer-empty">No machines paired yet. Show a code here, or add a machine that's showing one.</p>{{end}}
{{end}}
{{define "peer-group-head"}}
    <div class="peer-group-title"><span class="peer-group-name">on {{.Peer}}</span>{{if .Admin}}<span class="peer-group-addr">{{.Host}}:{{.Port}}</span><span class="peer-group-status peer-group-{{.Status}}" title="{{.StatusDetail}}">{{.Status}}</span><span class="peer-group-key" title="key fingerprint">key {{.Key}}</span><span class="peer-group-btns"><button type="button" class="btn btn-sm" data-peer="{{.Peer}}" data-host="{{.Host}}" data-port="{{.Port}}" data-fp="{{.Fingerprint}}" onclick="openPeerEdit(this)">Edit</button><button type="button" class="btn btn-sm btn-danger" data-peer="{{.Peer}}" onclick="askRemovePeer(this)">Remove</button></span>{{end}}</div>
    <div class="peer-confirm peer-remove-confirm" style="display:none"></div>
{{end}}
{{if or .PeerGroups .PeerAdmin}}
<section class="peer-section" id="peer-list" style="display:{{.ListDisplay}}">
  {{template "peers-head" .}}
  {{range .PeerGroups}}
  <div class="peer-group">
    {{template "peer-group-head" .}}
    {{if .Routes}}
    <table class="route-table">
    {{template "route-colgroup"}}
    <tbody>
    {{range .Routes}}
    <tr>
      <td>{{if .ShadowedBy}}<div class="route-name-cell"><span class="led row-led {{.LEDClass}}"></span><span class="route-icon route-icon-stopped">{{iconHTML .Icon}}</span><div><span class="route-name-link" style="opacity:.5">{{.Name}}</span><span class="route-url">{{.Name}}.{{$.TLD}}</span></div></div>{{else}}<a class="route-name-cell" href="{{.VibeURL}}" target="_blank"><span class="led row-led {{.LEDClass}}"></span><span class="{{if .Live}}route-icon{{else}}route-icon route-icon-stopped{{end}}">{{iconHTML .Icon}}</span><div><span class="route-name-link">{{.Name}}</span><span class="route-url">{{.Name}}.{{$.TLD}}</span></div></a>{{end}}</td>
      <td class="td-type">peer</td>
      <td class="td-port">&mdash;</td>
      <td class="td-age hide-mobile">&mdash;</td>
      <td><div class="td-actions">{{if .ShadowedBy}}<span class="peer-shadow">shadowed by {{.ShadowedBy}}</span>{{else}}<span class="peer-status peer-status-{{.Status}}">{{.Status}}</span>{{end}}</div></td>
    </tr>
    {{end}}
    </tbody></table>
    {{end}}
  </div>
  {{end}}
</section>
<section class="peer-section" id="peer-grid" style="display:{{.GridDisplay}}">
  {{template "peers-head" .}}
  {{range .PeerGroups}}
  <div class="peer-grid-group">
    {{template "peer-group-head" .}}
    <div class="grid-container">
    {{range .Routes}}
    {{if .ShadowedBy}}
    <div class="grid-tile tile-stopped" title="shadowed by {{.ShadowedBy}}">
      <div class="tile-icon">{{iconHTML .Icon}}</div>
      <div class="tile-name">{{.Name}}</div>
      <div class="tile-url">shadowed by {{.ShadowedBy}}</div>
    </div>
    {{else}}
    <a href="{{.VibeURL}}" target="_blank" title="{{.Status}}" class="{{if .Live}}grid-tile{{else}}grid-tile tile-stopped{{end}}">
      <div class="tile-icon">{{iconHTML .Icon}}</div>
      <div class="tile-name">{{.Name}}</div>
      <div class="tile-url">{{if .Live}}{{.Name}}.{{$.TLD}}{{else}}{{.Status}}{{end}}</div>
    </a>
    {{end}}
    {{end}}
    </div>
  </div>
  {{end}}
</section>
{{end}}

{{if .ShowGetStarted}}
<section class="get-started">
  <h2>Get started</h2>
  <p>Paste this into Claude Code, Cursor, or any agentic IDE to configure a project with local.vibe.</p>
  <div class="setup-box">
    <textarea id="setup-text" class="setup-textarea" rows="5" readonly>This machine is running local.vibe, a local DNS tool that gives dev servers friendly .{{.TLD}} names instead of hard-to-remember port numbers.

Read the full setup instructions:

  curl http://localhost:7999/setup.md

Or open in a browser: {{.Scheme}}://local.{{.TLD}}/setup.md</textarea>
    <button class="btn-copy" id="copy-btn" onclick="copyText('setup-text','copy-btn')">Copy</button>
  </div>
</section>
{{end}}
</main>

<!-- Get Started Modal — reachable from the footer once the inline card retires -->
<div class="modal-overlay" id="getstarted-overlay" onclick="if(event.target===this)closeGetStarted()">
<div class="modal">
  <div class="modal-header">
    <div class="modal-header-text">
      <div class="modal-eyebrow">Setup</div>
      <h3>Get started</h3>
      <div class="modal-sub">Configure a project to use local.vibe.</div>
    </div>
  </div>
  <div class="modal-body">
    <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">Paste this into Claude Code, Cursor, or any agentic IDE to configure a project with local.vibe.</p>
    <div class="setup-box">
      <textarea id="setup-text-modal" class="setup-textarea" rows="7" readonly>This machine is running local.vibe, a local DNS tool that gives dev servers friendly .{{.TLD}} names instead of hard-to-remember port numbers.

Read the full setup instructions:

  curl http://localhost:7999/setup.md

Or open in a browser: {{.Scheme}}://local.{{.TLD}}/setup.md</textarea>
      <button class="btn-copy" id="copy-btn-modal" onclick="copyText('setup-text-modal','copy-btn-modal')">Copy</button>
    </div>
  </div>
  <div class="modal-actions">
    <button class="btn" onclick="closeGetStarted()">Close</button>
  </div>
</div>
</div>

<!-- Enable peers (experimental) -->
{{if .PeerAdmin}}
<div class="modal-overlay" id="peer-enable-overlay" onclick="if(event.target===this)closePeerDialog('peer-enable-overlay')">
<div class="modal" role="dialog" aria-labelledby="peer-enable-heading">
  <div class="modal-header"><div class="modal-header-text">
    <div class="modal-eyebrow">Peers · experimental</div>
    <h3 id="peer-enable-heading">Enable peers</h3>
    <div class="modal-sub">Browse other machines' .{{.TLD}} routes from this one.</div>
  </div></div>
  <div class="modal-body">
    <ul class="peer-basics">
      <li>Peers let you open another machine's .{{.TLD}} routes from this one, over an encrypted connection between the two vibe daemons.</li>
      <li>Nothing is reachable until you pair: a machine must show a one-time code and you must enter it. Pairing pins both machines' keys.</li>
      <li>vibe only listens on the network (port {{.PeerPort}}) while you have paired machines or a code is showing — and only paired machines, or one holding the current code, get through. Turning peers off stops it and keeps your pairings for next time.</li>
    </ul>
    <div class="peer-msg" id="peer-enable-msg" style="display:none"></div>
  </div>
  <div class="modal-actions">
    <button class="btn" onclick="closePeerDialog('peer-enable-overlay')">Cancel</button>
    <button class="btn-add" id="peer-enable-submit" onclick="setPeersEnabled(true)">Enable</button>
  </div>
</div>
</div>

<!-- Show a code (experimental) -->
<div class="modal-overlay" id="peer-code-overlay" onclick="if(event.target===this)closePeerDialog('peer-code-overlay')">
<div class="modal" role="dialog" aria-labelledby="peer-code-heading">
  <div class="modal-header"><div class="modal-header-text">
    <div class="modal-eyebrow">Peers · experimental</div>
    <h3 id="peer-code-heading">Pair another machine with this one</h3>
    <div class="modal-sub">On the other machine: Add peer, pick this machine (or type an address below), and enter the code.</div>
  </div></div>
  <div class="modal-body">
    <div class="peer-code-big" id="peer-code-value">…</div>
    <dl class="peer-code-facts">
      <dt>This machine</dt><dd id="peer-code-name"></dd>
      <dt>Key</dt><dd id="peer-code-key"></dd>
      <dt>Addresses</dt><dd id="peer-code-addrs"></dd>
    </dl>
    <p class="hint" id="peer-code-expiry"></p>
    <div class="peer-msg" id="peer-code-msg" style="display:none"></div>
  </div>
  <div class="modal-actions">
    <button class="btn" id="peer-code-new" style="display:none" onclick="openShowCode()">Show a new code</button>
    <button class="btn-add" onclick="closePeerDialog('peer-code-overlay')">Done</button>
  </div>
</div>
</div>
{{end}}

<!-- Add peer (experimental) -->
{{if .PeerAdmin}}
<div class="modal-overlay" id="peer-overlay" onclick="if(event.target===this)closePeerModal()">
<div class="modal peer-picker" role="dialog" aria-labelledby="peer-modal-heading">
  <div class="modal-header"><div class="modal-header-text">
    <div class="modal-eyebrow">Peers · experimental</div>
    <h3 id="peer-modal-heading">Add peer</h3>
    <div class="modal-sub">Machines showing a pairing code appear here. Names are what each machine says it is — check its key on its screen.</div>
  </div></div>
  <div class="modal-body">
    <div class="peer-found-head">On this network<span class="spinner" id="peer-scan-spin"></span></div>
    <div class="peer-found" id="peer-found-lan"></div>
    <div class="peer-found-head">Tailscale</div>
    <div class="peer-found" id="peer-found-tailscale"></div>
    <div class="peer-notes" id="peer-notes"></div>
    <div class="peer-found-head">Or enter an address</div>
    <div class="peer-typed">
      <input id="peer-typed-host" type="text" placeholder="host or host:port" autocomplete="off" spellcheck="false">
      <button type="button" class="btn btn-sm" onclick="checkTypedPeer()">Check</button>
    </div>
    <div class="peer-found" id="peer-found-typed"></div>
  </div>
  <div class="modal-actions">
    <button class="btn" onclick="rescanPeers()">Search again</button>
    <button class="btn-add" onclick="closePeerModal()">Done</button>
  </div>
</div>
</div>

<!-- Edit peer (experimental) -->
<div class="modal-overlay" id="peer-edit-overlay" onclick="if(event.target===this)closePeerDialog('peer-edit-overlay')">
<div class="modal" role="dialog" aria-labelledby="peer-edit-heading">
  <div class="modal-header"><div class="modal-header-text">
    <div class="modal-eyebrow">Peers · experimental</div>
    <h3 id="peer-edit-heading">Edit peer</h3>
    <div class="modal-sub">Its key can't change — a different address only changes where this machine looks for it.</div>
  </div></div>
  <div class="modal-body">
    <div class="field-row">
      <div class="field"><label for="peer-edit-name">Name</label><input id="peer-edit-name" type="text" autocomplete="off" spellcheck="false"></div>
    </div>
    <div class="field-row">
      <div class="field"><label for="peer-edit-host">Host</label><input id="peer-edit-host" type="text" autocomplete="off" spellcheck="false" onblur="probeEditedPeer()"></div>
      <div class="field" style="max-width:110px"><label for="peer-edit-port">Port</label><input id="peer-edit-port" type="text" inputmode="numeric" autocomplete="off" onblur="probeEditedPeer()"></div>
    </div>
    <div class="field-row">
      <div class="field"><label for="peer-edit-fp">Key fingerprint</label><input id="peer-edit-fp" type="text" readonly></div>
    </div>
    <div class="peer-msg" id="peer-edit-msg" style="display:none"></div>
  </div>
  <div class="modal-actions">
    <button class="btn" onclick="closePeerDialog('peer-edit-overlay')">Cancel</button>
    <button class="btn-add" id="peer-edit-save" onclick="savePeerEdit()">Save</button>
  </div>
</div>
</div>
{{end}}

<!-- Right-click context menu for list rows -->
<div class="ctx-menu" id="ctx-menu"></div>

<!-- Add/Edit Modal -->
<div class="modal-overlay" id="modal-overlay" onclick="if(event.target===this)closeModal()">
<div class="modal">
  <div class="modal-header">
    <button type="button" class="icon-trigger" id="icon-preview" onclick="toggleIconPopover('route-popover',event)" title="Change icon">?</button>
    <div class="modal-header-text">
      <div class="modal-eyebrow" id="modal-title">Add Route</div>
      <h3 id="modal-heading">New route</h3>
      <div class="modal-sub" id="modal-sub">Map a friendly .vibe name to a local port or external URL.</div>
    </div>
  </div>
  <div class="icon-popover" id="route-popover">
    <input id="route-icon" type="hidden">
    <div class="icon-popover-row">
      <input id="route-icon-custom" type="text" placeholder="Paste any emoji…" oninput="onCustomIcon('route-icon','icon-preview','icon-clear','icon-picker')">
      <button type="button" class="btn btn-sm" id="icon-clear" onclick="clearIcon('route-icon','icon-preview','icon-clear','icon-picker')" style="display:none">Clear</button>
    </div>
    <div class="icon-picker" id="icon-picker"></div>
  </div>
  <div class="modal-body">
    <div class="type-toggle" id="type-toggle">
      <button id="toggle-local" class="active" onclick="setRouteType('local')">Local Port</button>
      <button id="toggle-bookmark" onclick="setRouteType('bookmark')">External URL</button>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="route-name">Name</label>
        <input id="route-name" type="text" placeholder="myapp" autocomplete="off" oninput="updateModalHeading()">
      </div>
      <div id="port-field" class="field field-port">
        <label for="route-port">Port</label>
        <input id="route-port" type="number" placeholder="3000">
      </div>
    </div>
    <div id="url-field" class="field" style="display:none">
      <label for="route-url">URL</label>
      <input id="route-url" type="text" placeholder="example.com:8080">
    </div>
    <div id="options-card" class="options-card" style="display:none">
      <div id="proxy-field" class="opt">
        <label class="checkbox-row">
          <input id="route-proxy" type="checkbox" onchange="onProxyToggle()">
          <span>Proxy instead of redirect</span>
        </label>
        <p class="hint">Keep <code>.vibe</code> in the browser URL. Useful for mirroring Tailscale or intranet hosts on a friendly name.</p>
      </div>
      <div id="insecure-field" class="opt" style="display:none">
        <label class="checkbox-row">
          <input id="route-insecure" type="checkbox">
          <span>Allow self-signed TLS cert</span>
        </label>
        <p class="hint">Only enable when the upstream uses an untrusted certificate (e.g. Tailscale MagicDNS).</p>
      </div>
    </div>
  </div>
  <div class="modal-actions">
    <button class="btn btn-danger" id="modal-delete" style="display:none;margin-right:auto" onclick="deleteRoute()">Delete route</button>
    <button class="btn" onclick="closeModal()">Cancel</button>
    <button class="btn-add" id="modal-save" onclick="saveRoute()">Add</button>
  </div>
</div>
</div>
<!-- Managed Route Settings Modal -->
<div class="modal-overlay" id="managed-overlay" onclick="if(event.target===this)closeManagedModal()">
<div class="modal">
  <div class="modal-header">
    <button type="button" class="icon-trigger" id="managed-icon-preview" onclick="toggleIconPopover('managed-popover',event)" title="Change icon">?</button>
    <div class="modal-header-text">
      <div class="modal-eyebrow">Managed Route</div>
      <h3 id="managed-heading">Settings</h3>
      <div class="modal-sub">Configure a daemon-managed process.</div>
    </div>
  </div>
  <div class="icon-popover" id="managed-popover">
    <input id="managed-icon" type="hidden">
    <div class="icon-popover-row">
      <input id="managed-icon-custom" type="text" placeholder="Paste any emoji…" oninput="onCustomIcon('managed-icon','managed-icon-preview','managed-icon-clear','managed-icon-picker')">
      <button type="button" class="btn btn-sm" id="managed-icon-clear" onclick="clearIcon('managed-icon','managed-icon-preview','managed-icon-clear','managed-icon-picker')" style="display:none">Clear</button>
    </div>
    <div class="icon-picker" id="managed-icon-picker"></div>
  </div>
  <div class="modal-body">
    <div class="field">
      <label for="managed-name">Name</label>
      <input id="managed-name" type="text" placeholder="myapp" autocomplete="off" oninput="updateManagedHeading()">
    </div>
    <div class="field">
      <label for="idle-timeout">Auto-stop after idle (minutes)</label>
      <input id="idle-timeout" type="number" min="0" placeholder="0 = never">
      <p class="hint">Stop the process automatically when no traffic is received. Set to <code>0</code> to disable.</p>
    </div>
  </div>
  <div class="modal-actions">
    <button class="btn btn-danger" style="margin-right:auto" onclick="deleteManagedRoute()">Delete route</button>
    <button class="btn" onclick="closeManagedModal()">Cancel</button>
    <button class="btn-add" onclick="saveManagedSettings()">Save</button>
  </div>
</div>
</div>
<script>
function setView(mode,save){
  var l=document.getElementById('list-view'),g=document.getElementById('grid-view');
  var bl=document.getElementById('btn-list'),bg=document.getElementById('btn-grid');
  if(mode==='grid'){l.style.display='none';g.style.display='block';bl.classList.remove('active');bg.classList.add('active')}
  else{l.style.display='block';g.style.display='none';bl.classList.add('active');bg.classList.remove('active')}
  var pl=document.getElementById('peer-list'),pg=document.getElementById('peer-grid');
  if(pl){pl.style.display=mode==='grid'?'none':'block';pg.style.display=mode==='grid'?'block':'none'}
  if(save)fetch('/_api/preferences',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({view:mode})});
}

// --- Search filter -----------------------------------------------------
// Pure client-side: hides non-matching rows/tiles/peer rows. Matches on the
// visible text of the name cell (name + url + type), case-insensitive.
function rowMatches(el,q){
  return !q||(el.textContent||'').toLowerCase().indexOf(q)!==-1;
}
function filterRoutes(raw){
  var q=raw.trim().toLowerCase();
  var matches=0;
  var rows=Array.prototype.slice.call(document.querySelectorAll('#list-view tbody tr'));
  rows.forEach(function(tr){
    if(tr.classList.contains('wt-group-header'))return;
    var m=rowMatches(tr.cells[0],q)||rowMatches(tr.cells[1],q);
    tr.style.display=m?'':'none';
    if(m)matches++;
  });
  // A worktree group header stays visible while any row of its group is.
  rows.forEach(function(tr,i){
    if(!tr.classList.contains('wt-group-header'))return;
    var vis=false;
    for(var j=i+1;j<rows.length;j++){
      if(rows[j].classList.contains('wt-group-header'))break;
      if(!rows[j].classList.contains('wt-tr'))break;
      if(rows[j].style.display!=='none'){vis=true;break}
    }
    tr.style.display=vis?'':'none';
  });
  Array.prototype.slice.call(document.querySelectorAll('#grid-view .grid-tile')).forEach(function(tile){
    tile.style.display=rowMatches(tile,q)?'':'none';
  });
  // Peer groups (both renderings mirror the same data): hide rows/tiles,
  // then groups with nothing left, then the sections. Sections toggle via a
  // class so the list/grid view's inline display is left alone.
  var peerMatches=0;
  Array.prototype.slice.call(document.querySelectorAll('.peer-group')).forEach(function(g){
    var any=false;
    Array.prototype.slice.call(g.querySelectorAll('tbody tr')).forEach(function(tr){
      var m=rowMatches(tr,q);
      tr.style.display=m?'':'none';
      if(m){any=true;peerMatches++}
    });
    g.classList.toggle('filter-hide',!any);
  });
  Array.prototype.slice.call(document.querySelectorAll('.peer-grid-group')).forEach(function(g){
    var any=false;
    Array.prototype.slice.call(g.querySelectorAll('.grid-tile')).forEach(function(tile){
      var m=rowMatches(tile,q);
      tile.style.display=m?'':'none';
      if(m)any=true;
    });
    g.classList.toggle('filter-hide',!any);
  });
  Array.prototype.slice.call(document.querySelectorAll('.peer-section')).forEach(function(sec){
    sec.classList.toggle('filter-hide',!!q&&peerMatches===0);
  });
  var empty=document.getElementById('search-empty');
  var show=q&&matches===0&&peerMatches===0;
  document.getElementById('search-empty-q').textContent=raw.trim();
  empty.style.display=show?'':'none';
}
document.addEventListener('keydown',function(e){
  if(e.key==='/'&&!e.metaKey&&!e.ctrlKey&&!e.altKey){
    var t=e.target.tagName;
    if(t!=='INPUT'&&t!=='TEXTAREA'&&t!=='SELECT'){
      e.preventDefault();
      document.getElementById('search-input').focus();
    }
  }
});

// --- Column sort (list view) -------------------------------------------
// Sorts worktree groups as units so children stay under their parent; the
// daemon's own "local" row stays pinned to the top. Keys come from data-*
// attributes rendered server-side (age as seconds, not the display string).
var sortState={key:'',dir:1};
function sortTable(key){
  if(sortState.key===key){sortState.dir=-sortState.dir}else{sortState={key:key,dir:1}}
  var tbody=document.querySelector('#list-view tbody');
  var rows=Array.prototype.slice.call(tbody.rows);
  var pinned=document.getElementById('row-local');
  rows=rows.filter(function(tr){return tr!==pinned});
  var blocks=[],cur=null;
  rows.forEach(function(tr){
    if(tr.classList.contains('wt-group-header')){cur={head:tr,main:null,kids:[]};blocks.push(cur);return}
    if(tr.classList.contains('wt-tr')&&cur){cur.kids.push(tr);return}
    cur={head:null,main:tr,kids:[]};blocks.push(cur);
  });
  function rowKey(tr){
    if(!tr)return null;
    if(key==='name')return (tr.getAttribute('data-name')||'').toLowerCase();
    var v=parseInt(tr.getAttribute('data-'+key),10);
    return isNaN(v)?-1:v;
  }
  function blockKey(b){
    var k=rowKey(b.main||b.kids[0]);
    if(k===null)k=(key==='name')?'':-1;
    return k;
  }
  function cmp(a,b){return a<b?-sortState.dir:a>b?sortState.dir:0}
  blocks.sort(function(a,b){return cmp(blockKey(a),blockKey(b))});
  blocks.forEach(function(b){b.kids.sort(function(x,y){return cmp(rowKey(x),rowKey(y))})});
  if(pinned)tbody.appendChild(pinned);
  blocks.forEach(function(b){
    if(b.head)tbody.appendChild(b.head);
    if(b.main)tbody.appendChild(b.main);
    b.kids.forEach(function(k){tbody.appendChild(k)});
  });
  ['name','port','age'].forEach(function(k){
    var a=document.getElementById('arrow-'+k);
    if(a)a.textContent=(k===key)?(sortState.dir===1?'↑':'↓'):'';
  });
}

// --- Row context menu (list view) ----------------------------------------
// Start/Stop/Edit proxy the row's own controls so behavior (spinners, polling,
// error toasts) is identical to clicking the buttons. Rename edits in place.
var ctxRow=null;
document.addEventListener('contextmenu',function(e){
  closeCtxMenu();
  var tr=e.target.closest('#list-view tbody tr');
  if(!tr||!tr.getAttribute('data-name'))return;
  if(tr.querySelector('.rename-input'))return;
  var items=[];
  var mainBtn=tr.querySelector('.act-main .btn');
  var editBtn=tr.querySelector('.act-edit .btn-icon');
  if(mainBtn&&!mainBtn.disabled)items.push({label:mainBtn.textContent.trim(),act:function(){mainBtn.click()}});
  var running=mainBtn&&mainBtn.textContent.trim()==='Stop';
  if(!tr.classList.contains('wt-tr')&&!running)items.push({label:'Rename',act:function(){startRename(tr)}});
  if(editBtn)items.push({label:'Edit…',act:function(){editBtn.click()}});
  if(!items.length)return;
  e.preventDefault();
  ctxRow=tr;
  var menu=document.getElementById('ctx-menu');
  menu.innerHTML='';
  items.forEach(function(it){
    var b=document.createElement('button');
    b.type='button';b.textContent=it.label;
    b.onclick=function(){closeCtxMenu();it.act()};
    menu.appendChild(b);
  });
  menu.classList.add('active');
  var mw=menu.offsetWidth,mh=menu.offsetHeight;
  menu.style.left=Math.min(e.clientX,window.innerWidth-mw-8)+'px';
  menu.style.top=Math.min(e.clientY,window.innerHeight-mh-8)+'px';
});
function closeCtxMenu(){
  document.getElementById('ctx-menu').classList.remove('active');
  ctxRow=null;
}
document.addEventListener('click',function(){closeCtxMenu()});
window.addEventListener('scroll',closeCtxMenu,true);
window.addEventListener('resize',closeCtxMenu);

// Inline rename: swaps the row's name for an input. Enter saves (PUT with just
// the new name — the API merges), Escape or clicking away cancels.
function startRename(tr){
  var cell=tr.querySelector('.route-name-cell');
  var nameSpan=tr.querySelector('.route-name-link');
  var urlSpan=tr.querySelector('.route-url');
  var old=tr.getAttribute('data-name');
  if(!cell||!nameSpan)return;
  var inp=document.createElement('input');
  inp.className='rename-input';
  inp.value=old;inp.spellcheck=false;inp.autocomplete='off';
  inp.title='Enter to save · Esc to cancel';
  nameSpan.style.display='none';
  if(urlSpan)urlSpan.style.display='none';
  nameSpan.parentNode.insertBefore(inp,nameSpan);
  // The cell is a link; disarm navigation while the input is live.
  var savedHref=null;
  if(cell.tagName==='A'){savedHref=cell.getAttribute('href');cell.removeAttribute('href')}
  function finish(){
    inp.remove();
    nameSpan.style.display='';
    if(urlSpan)urlSpan.style.display='';
    if(savedHref!==null)cell.setAttribute('href',savedHref);
  }
  inp.onclick=function(e){e.stopPropagation();e.preventDefault()};
  inp.onblur=function(){if(!inp.disabled)finish()};
  inp.onkeydown=function(e){
    e.stopPropagation();
    if(e.key==='Escape'){finish();return}
    if(e.key!=='Enter')return;
    var nn=inp.value.trim().toLowerCase();
    if(nn===old){finish();return}
    if(!/^[a-z0-9-]+$/.test(nn)){showToast('Names are lowercase letters, digits, and hyphens');return}
    inp.disabled=true;
    fetch('/_api/routes/'+encodeURIComponent(old),{
      method:'PUT',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({name:nn})
    }).then(function(r){
      if(!r.ok)return r.json().then(function(d){throw new Error(d.error||'Rename failed')});
      location.reload();
    }).catch(function(err){
      inp.disabled=false;inp.focus();
      showToast(err.message||'Rename failed');
    });
  };
  inp.focus();inp.select();
}

var modalMode='add';
var editingName='';
function setRouteType(t){
  var modal=document.querySelector('#modal-overlay .modal');
  var animate=modal&&document.getElementById('modal-overlay').classList.contains('active');
  var fromH=animate?modal.offsetHeight:0;
  document.getElementById('toggle-local').className=t==='local'?'active':'';
  document.getElementById('toggle-bookmark').className=t==='bookmark'?'active':'';
  document.getElementById('port-field').style.display=t==='local'?'':'none';
  document.getElementById('url-field').style.display=t==='bookmark'?'':'none';
  document.getElementById('proxy-field').style.display=t==='bookmark'?'':'none';
  document.getElementById('options-card').style.display=t==='bookmark'?'':'none';
  onProxyToggle();
  if(animate){
    var toH=modal.offsetHeight;
    if(toH!==fromH){
      modal.style.transition='none';
      modal.style.height=fromH+'px';
      modal.offsetHeight;
      modal.style.transition='height .3s cubic-bezier(.4,0,.2,1)';
      modal.style.height=toH+'px';
      setTimeout(function(){modal.style.transition='';modal.style.height=''},320);
    }
  }
}
function onProxyToggle(){
  var proxyOn=document.getElementById('route-proxy').checked;
  var bookmark=document.getElementById('toggle-bookmark').className==='active';
  document.getElementById('insecure-field').style.display=(bookmark&&proxyOn)?'':'none';
}
function updateModalHeading(){
  var n=document.getElementById('route-name').value.trim();
  document.getElementById('modal-heading').textContent=n?n+'.vibe':(modalMode==='edit'?'Edit route':'New route');
}
function updateManagedHeading(){
  var n=document.getElementById('managed-name').value.trim();
  document.getElementById('managed-heading').textContent=n?n+'.vibe':'Settings';
}
function openAddModal(){
  modalMode='add';editingName='';
  document.getElementById('modal-title').textContent='Add Route';
  document.getElementById('modal-heading').textContent='New route';
  document.getElementById('modal-sub').textContent='Map a friendly .vibe name to a local port or external URL.';
  document.getElementById('modal-save').textContent='Add Route';
  document.getElementById('modal-delete').style.display='none';
  document.getElementById('type-toggle').style.display='';
  document.getElementById('route-name').value='';
  document.getElementById('route-name').disabled=false;
  document.getElementById('route-port').value='';
  document.getElementById('route-url').value='';
  document.getElementById('route-proxy').checked=false;
  document.getElementById('route-insecure').checked=false;
  setIconField('route-icon','icon-preview','icon-clear','icon-picker','');
  setRouteType('local');
  document.getElementById('modal-overlay').classList.add('active');
}
function openEditModal(name,port,url,type,icon,autoIcon,proxy,insecure){
  modalMode='edit';editingName=name;
  document.getElementById('modal-title').textContent='Edit Route';
  document.getElementById('modal-heading').textContent=name+'.vibe';
  document.getElementById('modal-sub').textContent=type==='bookmark'?'Reverse-proxy or redirect to an external host.':'Forward .vibe traffic to a local port.';
  document.getElementById('modal-save').textContent='Save';
  document.getElementById('modal-delete').style.display='';
  document.getElementById('type-toggle').style.display='';
  document.getElementById('route-name').value=name;
  document.getElementById('route-name').disabled=false;
  document.getElementById('route-icon').dataset.autoicon=autoIcon||'';
  setIconField('route-icon','icon-preview','icon-clear','icon-picker',icon||'',autoIcon||'');
  document.getElementById('route-proxy').checked=!!proxy;
  document.getElementById('route-insecure').checked=!!insecure;
  if(type==='bookmark'){
    setRouteType('bookmark');
    document.getElementById('route-url').value=url;
    document.getElementById('route-port').value='';
  }else{
    setRouteType('local');
    document.getElementById('route-port').value=port||'';
    document.getElementById('route-url').value='';
  }
  document.getElementById('modal-overlay').classList.add('active');
}
function closeModal(){document.getElementById('modal-overlay').classList.remove('active');closeAllIconPopovers()}
function saveRoute(){
  var name=document.getElementById('route-name').value.trim();
  if(!name)return;
  var isBookmark=document.getElementById('toggle-bookmark').className==='active';
  var body={name:name,icon:getIconValue('route-icon')};
  if(isBookmark){
    var u=document.getElementById('route-url').value.trim();
    if(!u)return;
    if(u.indexOf('://')===-1)u='http://'+u;
    body.url=u;
    body.proxy=document.getElementById('route-proxy').checked;
    body.insecure_skip_verify=document.getElementById('route-insecure').checked;
  }else{
    var p=parseInt(document.getElementById('route-port').value);
    if(!p)return;
    body.port=p;
    body.proxy=false;
    body.insecure_skip_verify=false;
  }
  if(modalMode==='edit'){
    fetch('/_api/routes/'+encodeURIComponent(editingName),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(){location.reload()});
  }else{
    fetch('/_api/routes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(){location.reload()});
  }
}
function deleteRoute(){
  if(!editingName)return;
  fetch('/_api/routes/'+encodeURIComponent(editingName),{method:'DELETE',headers:{'Accept':'application/json'}}).then(function(){location.reload()});
}
function openGetStarted(){document.getElementById('getstarted-overlay').classList.add('active')}
function closeGetStarted(){document.getElementById('getstarted-overlay').classList.remove('active')}

// Peers switch + Show a code (experimental). Server text goes in via
// textContent only.
function closePeerDialog(id){var o=document.getElementById(id);if(o)o.classList.remove('active')}
function openEnablePeers(){var o=document.getElementById('peer-enable-overlay');if(o)o.classList.add('active')}
function showPeerOffConfirm(on){
  Array.prototype.slice.call(document.querySelectorAll('.peer-off-confirm')).forEach(function(el){el.style.display=on?'block':'none'});
}
function turnOffPeers(){showPeerOffConfirm(true)}
function setPeersEnabled(on){
  var msg=document.getElementById('peer-enable-msg');
  vibeAPI('POST','/_api/peers/enabled',{body:{enabled:on}},function(status,data){
    if(status>=200&&status<300){reloadSoon(300);return}
    var text=(data&&data.error)||(status?'Could not change the peers setting':'Could not reach the vibe daemon');
    if(on&&msg){msg.style.display='block';msg.className='peer-msg peer-msg-err';msg.textContent=text}else{showToast(text)}
  });
}
var peerCodeTimer=null;
function openShowCode(){
  var o=document.getElementById('peer-code-overlay');if(!o)return;
  var val=document.getElementById('peer-code-value'),exp=document.getElementById('peer-code-expiry'),again=document.getElementById('peer-code-new'),msg=document.getElementById('peer-code-msg');
  val.textContent='…';exp.textContent='';again.style.display='none';msg.style.display='none';
  o.classList.add('active');
  if(peerCodeTimer){clearInterval(peerCodeTimer);peerCodeTimer=null}
  vibeAPI('POST','/_api/peers/invite',{},function(status,data){
    if(!(status>=200&&status<300&&data&&data.code)){
      msg.style.display='block';msg.className='peer-msg peer-msg-err';
      msg.textContent=(data&&data.error)||'Could not open a code';return;
    }
    val.textContent=data.code;
    document.getElementById('peer-code-name').textContent=data.name||'';
    document.getElementById('peer-code-key').textContent=data.key||'';
    var addrs=(data.addresses||[]).slice();
    if(data.port&&data.port!==7444)addrs=addrs.map(function(a){return a+':'+data.port});
    document.getElementById('peer-code-addrs').textContent=addrs.length?addrs.join(', '):'(no network address found)';
    var until=new Date(data.expires_at).getTime();
    function tick(){
      var left=Math.max(0,Math.round((until-Date.now())/1000));
      if(left<=0){
        exp.textContent='This code expired. This machine is no longer findable.';
        val.classList.add('peer-code-expired');again.style.display='';
        clearInterval(peerCodeTimer);peerCodeTimer=null;return;
      }
      val.classList.remove('peer-code-expired');
      exp.textContent='Valid for '+Math.floor(left/60)+':'+('0'+(left%60)).slice(-2)+' — this machine is findable while the code shows.';
    }
    tick();peerCodeTimer=setInterval(tick,1000);
  });
}

// Add peer picker, edit and remove (experimental). Everything a machine
// reports about itself (name, messages) is untrusted: textContent only.
function el(tag,cls,text){var e=document.createElement(tag);if(cls)e.className=cls;if(text!=null)e.textContent=text;return e}
function peerStateLabel(st){return({pairing:'showing a code',vibe:'vibe here, no code',paired:'paired','trusts-us':'still trusts this machine','removed-us':'removed this machine',none:'no vibe found',blocked:'blocked'})[st]||st}
function renderPeerRow(r,box){
  var row=el('div','peer-row');
  var who=el('div','peer-row-who');
  who.appendChild(el('span','peer-row-name',r.name?('says it\'s '+r.name):(r.dns_name||r.host)));
  who.appendChild(el('span','peer-row-addr',r.host+(r.port&&r.port!==7444?':'+r.port:'')));
  if(r.key)who.appendChild(el('span','peer-row-key','key '+r.key));
  row.appendChild(who);
  row.appendChild(el('span','peer-row-state peer-state-'+r.state,peerStateLabel(r.state)));
  var detail=el('div','peer-row-detail');
  if(r.state==='pairing'){
    var input=el('input');input.type='text';input.placeholder='K7QM-3XR9';input.maxLength=11;input.spellcheck=false;input.autocomplete='off';
    var go=el('button','btn btn-sm','Pair');go.type='button';
    var out=el('div','peer-msg');out.style.display='none';
    go.onclick=function(){pairWithFound(r,input,go,out)};
    input.onkeydown=function(e){if(e.key==='Enter')pairWithFound(r,input,go,out)};
    detail.appendChild(input);detail.appendChild(go);detail.appendChild(out);
  }else if(r.message){detail.appendChild(el('div','hint',r.message))}
  row.appendChild(detail);
  box.appendChild(row);
}
function pairWithFound(r,input,btn,out){
  var code=input.value.trim();
  if(code.replace(/[-\s]/g,'').length!==8){out.style.display='block';out.className='peer-msg peer-msg-err';out.textContent='Codes look like K7QM-3XR9.';return}
  btn.disabled=true;btn.textContent='Pairing…';out.style.display='none';
  vibeAPI('POST','/_api/peers',{body:{host:r.host,port:r.port,code:code,fingerprint:r.fingerprint||''}},function(status,data){
    btn.disabled=false;btn.textContent='Pair';out.style.display='block';
    if(status>=200&&status<300){out.className='peer-msg';out.textContent='Paired with '+((data&&data.name)||r.host)+'. Loading its routes…';reloadSoon(1200);return}
    out.className='peer-msg peer-msg-err';out.textContent=(data&&data.error)||(status?'Pairing failed':'Could not reach the vibe daemon');
  });
}
function rescanPeers(){
  var lan=document.getElementById('peer-found-lan'),ts=document.getElementById('peer-found-tailscale'),notes=document.getElementById('peer-notes'),spin=document.getElementById('peer-scan-spin');
  lan.textContent='';ts.textContent='';notes.textContent='';spin.style.display='';
  lan.appendChild(el('div','hint','Searching…'));
  vibeAPI('POST','/_api/peers/discover',{timeout:10000},function(status,data){
    spin.style.display='none';lan.textContent='';
    if(!(status>=200&&status<300&&data)){lan.appendChild(el('div','hint peer-msg-err',(data&&data.error)||'Search failed'));return}
    var nL=0,nT=0;
    (data.candidates||[]).forEach(function(c){if(c.source==='tailscale'){renderPeerRow(c,ts);nT++}else{renderPeerRow(c,lan);nL++}});
    if(!nL)lan.appendChild(el('div','hint','No machine here is showing a code. On the other machine: Peers → Show a code.'));
    if(!nT)ts.appendChild(el('div','hint','No Tailscale machines found.'));
    (data.notes||[]).forEach(function(n){notes.appendChild(el('div','hint',n))});
  });
}
function parseHostPort(v){
  v=v.trim();var m=v.match(/^\[(.+)\]:(\d+)$/)||v.match(/^([^:]+):(\d+)$/);
  return m?{host:m[1],port:parseInt(m[2],10)}:{host:v,port:0};
}
function checkTypedPeer(){
  var hp=parseHostPort(document.getElementById('peer-typed-host').value),box=document.getElementById('peer-found-typed');
  box.textContent='';if(!hp.host)return;
  box.appendChild(el('div','hint','Checking…'));
  vibeAPI('POST','/_api/peers/probe',{body:hp},function(status,data){
    box.textContent='';
    if(status>=200&&status<300&&data){renderPeerRow(data,box);return}
    box.appendChild(el('div','hint peer-msg-err',(data&&data.error)||'Check failed'));
  });
}
function openPeerModal(){
  var o=document.getElementById('peer-overlay');if(!o)return;
  document.getElementById('peer-found-typed').textContent='';
  o.classList.add('active');rescanPeers();
}
function closePeerModal(){closePeerDialog('peer-overlay')}

var peerEditing=null;
function editMsg(text,isErr){var m=document.getElementById('peer-edit-msg');m.style.display=text?'block':'none';m.className='peer-msg'+(isErr?' peer-msg-err':'');m.textContent=text||''}
function openPeerEdit(btn){
  peerEditing=btn.getAttribute('data-peer');
  document.getElementById('peer-edit-name').value=peerEditing;
  document.getElementById('peer-edit-host').value=btn.getAttribute('data-host');
  document.getElementById('peer-edit-port').value=btn.getAttribute('data-port');
  document.getElementById('peer-edit-fp').value=btn.getAttribute('data-fp');
  editMsg('');document.getElementById('peer-edit-overlay').classList.add('active');
}
function probeEditedPeer(){
  var host=document.getElementById('peer-edit-host').value.trim(),port=parseInt(document.getElementById('peer-edit-port').value,10)||0;
  if(!host)return;
  vibeAPI('POST','/_api/peers/probe',{body:{host:host,port:port}},function(status,data){
    if(status>=200&&status<300&&data)editMsg(peerStateLabel(data.state)+' — '+data.message,data.state==='none'||data.state==='blocked'||data.state==='removed-us');
  });
}
function savePeerEdit(){
  var body={},name=document.getElementById('peer-edit-name').value.trim(),host=document.getElementById('peer-edit-host').value.trim(),port=parseInt(document.getElementById('peer-edit-port').value,10);
  if(name&&name!==peerEditing)body.name=name;
  body.host=host;if(port)body.port=port;
  var save=document.getElementById('peer-edit-save');save.disabled=true;
  vibeAPI('PUT','/_api/peers/'+encodeURIComponent(peerEditing),{body:body},function(status,data){
    save.disabled=false;
    if(status>=200&&status<300){reloadSoon(300);return}
    editMsg((data&&data.error)||'Could not save',true);
  });
}
function askRemovePeer(btn){
  var name=btn.getAttribute('data-peer'),box=btn.closest('.peer-group,.peer-grid-group').querySelector('.peer-remove-confirm');
  box.textContent='';
  box.appendChild(document.createTextNode('Remove '+name+'? It will need a new code to pair again. '));
  var yes=el('button','btn btn-sm btn-danger','Remove');yes.type='button';
  var no=el('button','btn btn-sm','Cancel');no.type='button';
  no.onclick=function(){box.style.display='none'};
  yes.onclick=function(){
    yes.disabled=true;
    vibeAPI('DELETE','/_api/peers/'+encodeURIComponent(name),{},function(status,data){
      if(status>=200&&status<300){reloadSoon(200);return}
      yes.disabled=false;showToast((data&&data.error)||'Could not remove '+name);
    });
  };
  box.appendChild(yes);box.appendChild(no);box.style.display='block';
}
document.addEventListener('keydown',function(e){
  if(e.key!=='Escape')return;
  ['peer-overlay','peer-edit-overlay','peer-code-overlay','peer-enable-overlay'].forEach(closePeerDialog);
});
document.addEventListener('keydown',function(e){
  if(e.key==='Enter'&&e.target&&e.target.id==='peer-typed-host')checkTypedPeer();
});
function copyText(taId,btnId){
  var ta=document.getElementById(taId);
  var btn=document.getElementById(btnId);
  if(navigator.clipboard&&window.isSecureContext){
    navigator.clipboard.writeText(ta.value).then(function(){
      btn.textContent='Copied';setTimeout(function(){btn.textContent='Copy'},1500);
    });
  }else{
    ta.select();document.execCommand('copy');window.getSelection().removeAllRanges();
    btn.textContent='Copied';setTimeout(function(){btn.textContent='Copy'},1500);
  }
}
var managedEditName='';
function openManagedModal(name,idle,icon,autoIcon){
  managedEditName=name;
  document.getElementById('managed-heading').textContent=name+'.vibe';
  document.getElementById('managed-name').value=name;
  document.getElementById('idle-timeout').value=idle||'';
  document.getElementById('managed-icon').dataset.autoicon=autoIcon||'';
  setIconField('managed-icon','managed-icon-preview','managed-icon-clear','managed-icon-picker',icon||'',autoIcon||'');
  document.getElementById('managed-overlay').classList.add('active');
}
function closeManagedModal(){document.getElementById('managed-overlay').classList.remove('active');closeAllIconPopovers()}
function deleteManagedRoute(){
  if(!managedEditName)return;
  fetch('/_api/routes/'+encodeURIComponent(managedEditName),{method:'DELETE',headers:{'Accept':'application/json'}}).then(function(){location.reload()});
}
function saveManagedSettings(){
  var name=document.getElementById('managed-name').value.trim();
  if(!name)return;
  var idle=parseInt(document.getElementById('idle-timeout').value)||0;
  var body={name:name,idle_timeout:idle,icon:getIconValue('managed-icon')};
  fetch('/_api/routes/'+encodeURIComponent(managedEditName),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(){location.reload()});
}
function setIconField(inputId,previewId,clearId,pickerId,val,autoIcon){
  var inp=document.getElementById(inputId);
  inp.value=val||'';
  if(autoIcon!==undefined)inp.dataset.autoicon=autoIcon;
  var display=val||inp.dataset.autoicon||'';
  setIconPreviewEl(document.getElementById(previewId),display);
  document.getElementById(clearId).style.display=val?'':'none';
  var customInp=document.getElementById(inputId+'-custom');
  if(customInp&&!val)customInp.value='';
  highlightPicker(pickerId,val||'');
}
function getIconValue(inputId){return document.getElementById(inputId).value}
function clearIcon(inputId,previewId,clearId,pickerId){
  var autoIcon=document.getElementById(inputId).dataset.autoicon||'';
  document.getElementById(inputId+'-custom').value='';
  setIconField(inputId,previewId,clearId,pickerId,'',autoIcon);
}
function onCustomIcon(inputId,previewId,clearId,pickerId){
  var val=document.getElementById(inputId+'-custom').value.trim();
  setIconField(inputId,previewId,clearId,pickerId,val);
}
var iconChoices=['🚀','🤖','📦','⚡','🔮','🎯','🛠️','💎','🧪','🌐','📡','🎨','🔒','🗂️','📊','🧩'];
function buildPicker(containerId,inputId,previewId,clearId,popoverId){
  var c=document.getElementById(containerId);
  c.innerHTML='';
  iconChoices.forEach(function(em){
    var b=document.createElement('button');
    b.type='button';b.className='icon-pick';b.textContent=em;
    b.onclick=function(){
      setIconField(inputId,previewId,clearId,containerId,em);
      if(popoverId)closeIconPopover(popoverId);
    };
    c.appendChild(b);
  });
}
function toggleIconPopover(id,e){
  if(e){e.stopPropagation()}
  var p=document.getElementById(id);
  var wasOpen=p.classList.contains('active');
  closeAllIconPopovers();
  if(!wasOpen)p.classList.add('active');
}
function closeIconPopover(id){document.getElementById(id).classList.remove('active')}
function closeAllIconPopovers(){
  document.querySelectorAll('.icon-popover.active').forEach(function(p){p.classList.remove('active')});
}
document.addEventListener('click',function(e){
  if(e.target.closest('.icon-popover')||e.target.closest('.icon-trigger'))return;
  closeAllIconPopovers();
});
function highlightPicker(containerId,val){
  var btns=document.getElementById(containerId).querySelectorAll('.icon-pick');
  btns.forEach(function(b){b.classList.toggle('selected',b.textContent===val)});
}
buildPicker('icon-picker','route-icon','icon-preview','icon-clear','route-popover');
buildPicker('managed-icon-picker','managed-icon','managed-icon-preview','managed-icon-clear','managed-popover');

function setIconPreviewEl(el,val){
  if(!val){el.textContent='?';el.style.backgroundImage='';return}
  if(val.startsWith('data:')||val.startsWith('http://')||val.startsWith('https://')){
    el.textContent='';el.style.backgroundImage='url('+val+')';
    el.style.backgroundSize='cover';el.style.backgroundPosition='center';
  }else{
    el.style.backgroundImage='';el.textContent=val;
  }
}
function routeAction(btn,name,action){
  var origText=btn.textContent;
  btn.disabled=true;
  btn.innerHTML='<span class="spinner"></span>';
  fetch('/_api/routes/'+encodeURIComponent(name)+'/'+action,{method:'POST',headers:{'Accept':'application/json'}})
    .then(function(r){
      if(!r.ok)return r.json().then(function(d){throw new Error(d.error||'Request failed')});
      return r.json();
    })
    .then(function(){
      if(action==='start'){pollReady(name)}
      else{pollStopped(name)}
    })
    .catch(function(e){
      btn.disabled=false;btn.textContent=origText;
      showToast(e.message||'Action failed');
    });
}
// Register-and-start a worktree that exists on disk but has no route yet.
// The daemon validates the path against what it discovers via git, so an
// arbitrary directory can't be registered through this.
function startDiscoveredWorktree(btn,parent,path){
  var origText=btn.textContent;
  btn.disabled=true;
  btn.innerHTML='<span class="spinner"></span>';
  fetch('/_api/routes/'+encodeURIComponent(parent)+'/worktrees',{
    method:'POST',
    headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({path:path})
  })
    .then(function(r){
      if(!r.ok)return r.json().then(function(d){throw new Error(d.error||'Could not start worktree')});
      return r.json();
    })
    .then(function(){location.reload()})
    .catch(function(e){
      btn.disabled=false;btn.textContent=origText;
      showToast(e.message||'Could not start worktree');
    });
}
function pollStopped(name){
  vibePoll(function(next){
    vibeAPI('GET','/_api/routes/'+encodeURIComponent(name)+'/ready',{},function(status,d){
      if(!d||!d.ready){reloadSoon();return}
      next();
    });
  },300,21,reloadSoon);
}
function pollReady(name){
  vibePoll(function(next){
    vibeAPI('GET','/_api/routes/'+encodeURIComponent(name)+'/ready',{},function(status,d){
      if(d&&d.ready){reloadSoon();return}
      if(d&&d.running===false){showToast(name+' crashed during startup');reloadSoon();return}
      next();
    });
  },500,61,reloadSoon);
}
document.addEventListener('keydown',function(e){
  if(e.key!=='Escape')return;
  if(document.querySelector('.modal-overlay.active')){closeModal();closeManagedModal();closeGetStarted();return}
  var si=document.getElementById('search-input');
  if(si&&si.value){si.value='';filterRoutes('')}
});
document.addEventListener('visibilitychange',function(){
  if(document.hidden)return;
  // Don't wipe in-progress state: a live inline rename or an active filter.
  if(document.querySelector('.rename-input'))return;
  var si=document.getElementById('search-input');
  if(si&&si.value)return;
  location.reload();
});
</script>
