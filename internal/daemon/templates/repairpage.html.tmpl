{{- /* repairpage.html.tmpl — "reconnecting..." page when a route's port stops answering. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
{{.Head}}
<style>{{.CSS}}</style>
<script>{{.JS}}</script>
</head>
<body class="page-centered">
<div class="card">
  <h1>{{.Name}}</h1>
  <div class="url">{{.Name}}.{{.TLD}}</div>
{{if .Starting}}
  <div class="status"><span class="led led-yellow pulse"></span>Starting</div>
  <div class="hint">
    <div class="label">Cold start</div>
    Launching the app and waiting for port {{.Port}}&hellip;
  </div>
{{else}}
  <div class="status"><span class="led led-yellow pulse"></span>Reconnecting</div>
  <div class="hint">
    <div class="label">Port {{.Port}} not responding</div>
    Looking for the app in logs and process listings&hellip;
  </div>
{{end}}
  <div class="page-spinner" id="spinner" style="display:block"></div>
  <div class="msg" id="msg">{{if .Starting}}Starting&hellip;{{else}}Probing&hellip;{{end}}</div>
  <div class="actions" id="actions"></div>
  <div class="error" id="error" style="display:none"></div>
</div>
<script>
var maxAttempts=30;

function showActions(html){
  var box=document.getElementById('actions');
  box.innerHTML=html;
  box.style.display='flex';
}

function giveUp(reason, restartable){
  document.getElementById('spinner').style.display='none';
  var msg=document.getElementById('msg');
  msg.textContent='Could not recover automatically';
  msg.style.color='var(--red)';
  var err=document.getElementById('error');
  err.textContent=reason||'No listening port found nearby.';
  err.style.display='block';
  var buttons='';
  if(restartable){
    buttons+='<button class="btn-add" onclick="restartApp()">Restart app</button>';
  }
  buttons+='<button class="btn secondary" onclick="window.location.reload()">Retry</button>';
  buttons+='<a class="btn secondary" href="/" style="text-decoration:none">Dashboard</a>';
  showActions(buttons);
}

function restartApp(){
  var btns=document.querySelectorAll('#actions .btn,#actions .btn-add');
  btns.forEach(function(b){b.disabled=true;});
  document.getElementById('spinner').style.display='block';
  document.getElementById('msg').style.color='';
  document.getElementById('msg').textContent='Restarting\u2026';
  document.getElementById('error').style.display='none';
  document.getElementById('actions').style.display='none';
  vibeAPI('POST','/_api/routes/{{.Name}}/start',{},function(status,d){
    if(status===200){setTimeout(pollRepair,500);return;}
    if(status===0){giveUp('Could not reach daemon', true);return;}
    giveUp((d&&d.error)||'Failed to start', true);
  });
}

function pollRepair(){
  vibePoll(function(next){
    vibeAPI('POST','/_api/routes/{{.Name}}/repair',{timeout:2500},function(status,d){
      if(d&&d.ok){
        document.getElementById('msg').textContent='Found it \u2014 reloading';
        document.getElementById('msg').style.color='var(--green)';
        reloadSoon(250);
        return;
      }
      if(d&&d.restartable&&d.failure){
        // The child died with a recorded failure. A reload lands on the start
        // page (recovery skips auto-spawn while a failure is set), which shows
        // the tailed log and recovery hint instead of a bare "no port" error.
        reloadSoon();
        return;
      }
      if(d&&d.restartable){
        giveUp(d.reason||'Process is not running.', true);
        return;
      }
      next();
    });
  },500,maxAttempts,function(){
    giveUp('Still no listener after '+Math.round(maxAttempts*0.5)+'s. The app may have crashed.', false);
  });
}

pollRepair();
</script>
</body>
</html>
