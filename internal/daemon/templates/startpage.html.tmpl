{{- /* startpage.html.tmpl — "not running" page for stopped managed routes.
       Auto-escaping covers route name (already validated) and route.Cmd
       (free-form user input). The {{.RecoveryInit}} block is JSON-marshaled
       upstream and passed as template.JS so it inlines safely inside <script>. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
{{.Head}}
<style>{{.CSS}}</style>
<script>{{.JS}}</script>
</head>
<body class="page-centered">
<div class="card">
  <h1>{{.Name}}</h1>
  <div class="url">{{.Name}}.{{.TLD}}</div>
  <div class="status"><span class="led led-red"></span>Stopped</div>
  <div class="cmd">{{.Cmd}}</div>
  <button class="start-btn" id="btn" onclick="handlePrimaryButton()">Cancel</button>
  <div class="page-spinner" id="spinner" style="display:block"></div>
  <div class="msg" id="msg" style="display:block;color:var(--text-muted)">Launching process…</div>
  <div class="recovery" id="recovery">
    <div class="recovery-msg" id="recovery-msg"></div>
    <button class="recovery-btn" id="recovery-btn" onclick="recoverAndRetry()"></button>
    <div class="log-tail" id="log-tail" style="display:none"></div>
  </div>
{{if .Worktrees}}
  <div class="wt-list">
    <div class="wt-list-title">Worktrees</div>
    {{range .Worktrees}}
    {{if .Registered}}
    <a class="wt-item" href="{{.URL}}"><span class="wt-dot{{if .Running}} on{{end}}"></span>{{.Name}}{{if not .Running}}<span class="wt-hint">stopped</span>{{end}}</a>
    {{else}}
    <a class="wt-item" href="#" onclick="startWorktree(this,{{.Path}});return false"><span class="wt-dot"></span>{{.Name}}<span class="wt-hint">not started — click to launch</span></a>
    {{end}}
    {{end}}
  </div>
{{end}}
</div>
<script>
// Register-and-start an on-disk worktree the daemon discovered but nobody
// has run `vibe start` in. The daemon inherits the app's cmd, assigns a
// port, and spawns it; we then navigate to the new route, whose starting
// page polls until it's ready.
function startWorktree(el,path){
  var hint=el.querySelector('.wt-hint');
  hint.textContent='starting…';
  vibeAPI('POST','/_api/routes/'+{{.Name}}+'/worktrees',{body:{path:path}},function(status,d){
    if(d&&d.url){window.location.href=d.url;return;}
    hint.textContent=(d&&d.error)||'failed';
  });
}
var lastRecovery=null;
var launchCanceled=false;
var activeXHR=null;
var launchMode='cancel'; // cancel | retry

function setLaunchMode(mode){
  launchMode=mode;
  var btn=document.getElementById('btn');
  if(mode==='cancel'){
    btn.disabled=false;
    btn.textContent='Cancel';
    return;
  }
  btn.disabled=false;
  btn.textContent='Retry';
}

function handlePrimaryButton(){
  if(launchMode==='cancel'){
    cancelLaunch();
    return;
  }
  startApp();
}

// showFailure renders a recorded failure: message, then the recovery
// button or the bare log tail.
function showFailure(f, fallback){
  var msg=document.getElementById('msg');
  setLaunchMode('retry');
  document.getElementById('spinner').style.display='none';
  msg.style.whiteSpace='pre-wrap';msg.style.textAlign='left';msg.style.fontSize='.75rem';
  msg.textContent=(f&&f.message)||fallback;
  msg.style.color='var(--red)';
  if(f&&f.recovery){showRecovery(f.recovery, f.log||'');}
  else if(f&&f.log){showFailureLog(f.log);}
}

// fetchFailureAndRender asks /ready a few times for the failure the daemon
// recorded after the readiness window closed.
function fetchFailureAndRender(){
  vibePoll(function(next){
    vibeAPI('GET','/_api/routes/{{.Name}}/ready',{timeout:2000},function(status,d){
      if(d&&d.failure){showFailure(d.failure,'Server never became ready');return;}
      next();
    });
  },1000,4,function(){
    setLaunchMode('retry');
    document.getElementById('spinner').style.display='none';
    var msg=document.getElementById('msg');
    msg.textContent='Taking too long \u2014 check logs';
    msg.style.color='var(--yellow)';
  });
}

function hideRecovery(){
  document.getElementById('recovery').style.display='none';
  lastRecovery=null;
}

function showRecovery(rec, logTail){
  lastRecovery=rec;
  var box=document.getElementById('recovery');
  var btn=document.getElementById('recovery-btn');
  document.getElementById('recovery-msg').textContent=rec.message||'Recoverable error';
  var logEl=document.getElementById('log-tail');
  if(rec.action==='info'){
    btn.style.display='none';
  }else{
    btn.style.display='inline-flex';
    btn.disabled=false;
    var label='Kill and Retry';
    if(rec.action==='kill_pid' && rec.pid) label='Kill PID '+rec.pid+' and Retry';
    else if(rec.action==='kill_port' && rec.port) label='Free Port '+rec.port+' and Retry';
    else if(rec.action==='restart') label=(rec.pid?'Restart Process (PID '+rec.pid+')':'Restart Process');
    else if(rec.action==='edit_cmd' && rec.suggested_cmd) label='Use \u0060'+rec.suggested_cmd+'\u0060 and Retry';
    btn.textContent=label;
  }
  if(logTail){logEl.textContent=logTail;logEl.style.display='block';}else{logEl.style.display='none';}
  box.style.display='block';
}

function showFailureLog(logTail){
  lastRecovery=null;
  var box=document.getElementById('recovery');
  var btn=document.getElementById('recovery-btn');
  var logEl=document.getElementById('log-tail');
  document.getElementById('recovery-msg').textContent='No automatic recovery available. See log tail:';
  btn.style.display='none';
  if(logTail){logEl.textContent=logTail;logEl.style.display='block';}else{logEl.style.display='none';}
  box.style.display='block';
}

function startApp(body){
  launchCanceled=false;
  hideRecovery();
  var spinner=document.getElementById('spinner');
  var msg=document.getElementById('msg');
  setLaunchMode('cancel');
  spinner.style.display='block';
  msg.style.display='block';
  msg.style.color='var(--text-muted)';
  msg.style.whiteSpace='normal';msg.style.textAlign='center';msg.style.fontSize='.8rem';
  msg.textContent='Launching process\u2026';

  activeXHR=vibeAPI('POST','/_api/routes/{{.Name}}/start',{body:body||null},function(status,d){
    activeXHR=null;
    if(launchCanceled){return;}
    if(status===200){
      msg.textContent='Waiting for server\u2026';
      pollUntilReady();
      return;
    }
    if(status===0){
      setLaunchMode('retry');
      spinner.style.display='none';
      msg.textContent='Could not reach daemon';
      msg.style.color='var(--red)';
      return;
    }
    // A start error carries the same shape as a failure: error text plus an
    // optional recovery hint and log tail.
    showFailure({message:(d&&d.error)||'Failed to start',recovery:d&&d.recovery,log:d&&d.log},'Failed to start');
  });
}

function cancelLaunch(){
  launchCanceled=true;
  if(activeXHR){
    try{activeXHR.abort();}catch(e){}
    activeXHR=null;
  }
  var btn=document.getElementById('btn');
  var spinner=document.getElementById('spinner');
  var msg=document.getElementById('msg');
  btn.disabled=true;
  vibeAPI('DELETE','/_api/routes/{{.Name}}/stop',{},function(status){
    spinner.style.display='none';
    msg.style.display='block';
    msg.style.whiteSpace='normal';msg.style.textAlign='center';msg.style.fontSize='.8rem';
    msg.textContent=status?'Start canceled':'Could not cancel cleanly — safe to retry';
    msg.style.color='var(--yellow)';
    setLaunchMode('retry');
  });
}

function recoverAndRetry(){
  if(!lastRecovery)return;
  var rbtn=document.getElementById('recovery-btn');
  rbtn.disabled=true;
  if(lastRecovery.action==='restart'){
    vibeAPI('DELETE','/_api/routes/{{.Name}}/stop',{},function(status){
      setTimeout(startApp,status?300:0);
    });
    return;
  }
  if(lastRecovery.action==='edit_cmd' && lastRecovery.suggested_cmd){
    var suggested=lastRecovery.suggested_cmd;
    vibeAPI('PUT','/_api/routes/{{.Name}}',{body:{cmd:suggested}},function(status){
      if(status>=200&&status<300){
        var cmdEl=document.querySelector('.cmd');
        if(cmdEl)cmdEl.textContent=suggested;
        startApp();
        return;
      }
      rbtn.disabled=false;
      var em=document.getElementById('msg');
      em.style.display='block';em.style.color='var(--red)';
      em.textContent=status?'Failed to update command':'Could not reach daemon';
    });
    return;
  }
  var body={};
  if(lastRecovery.action==='kill_pid'&&lastRecovery.pid)body.kill_pid=lastRecovery.pid;
  else if(lastRecovery.action==='kill_port'&&lastRecovery.port)body.kill_port=lastRecovery.port;
  else return;
  startApp(body);
}

function pollUntilReady(){
  vibePoll(function(next){
    if(launchCanceled){return;}
    vibeAPI('GET','/_api/routes/{{.Name}}/ready',{timeout:2000},function(status,d){
      if(d&&d.ready){
        document.getElementById('msg').textContent='Ready';
        document.getElementById('msg').style.color='var(--green)';
        reloadSoon(300);
        return;
      }
      if(d&&d.running===false){
        showFailure(d.failure,'Process crashed \u2014 check logs at ~/.vibe/{{.Name}}.log');
        return;
      }
      next();
    });
  },500,70,fetchFailureAndRender);
}
{{.RecoveryInit}}
{{if .AutoLaunch}}
var vibeAutoLaunch=true;
startApp();
{{else}}
// Picker mode: worktrees exist, so the visitor chooses — no auto-launch.
var vibeAutoLaunch=false;
setLaunchMode('retry');
document.getElementById('btn').textContent='Start';
document.getElementById('spinner').style.display='none';
document.getElementById('msg').style.display='none';
{{end}}
</script>
</body>
</html>
